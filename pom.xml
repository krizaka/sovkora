<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The Sovkora reactor: every Java module of the platform, in this one repository (ADR-029).
         `./mvnw verify` builds and tests them together; `./mvnw verify -pl <module> -amd` tests one module and
         what depends on it. The build conventions live in build/sovkora-parent, which inherits krizaka-parent
         from Maven Central. -->
    <parent>
        <groupId>com.krizaka.sovkora</groupId>
        <artifactId>sovkora-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>build/sovkora-parent/pom.xml</relativePath>
    </parent>

    <artifactId>sovkora-reactor</artifactId>
    <packaging>pom</packaging>
    <name>sovkora-reactor</name>
    <description>Sovkora: the reactor of every Java module (build, contracts, engine, services, e2e)</description>
    <url>https://github.com/krizaka/sovkora</url>
    <licenses>
        <license>
            <name>FSL-1.1-ALv2</name>
            <url>https://fsl.software/FSL-1.1-ALv2.template.md</url>
            <distribution>repo</distribution>
            <comments>Functional Source License 1.1, Apache-2.0 future licence (ADR-011), except the folders with their own
                LICENSE (Apache-2.0: build, contracts, services/edge, apps/cli, packs). See NOTICE.</comments>
        </license>
    </licenses>

    <properties>
        <!-- The reactor is never published: only the service images ship. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>build</module>
        <module>contracts</module>
        <module>services/studio</module>
        <module>engine</module>
        <module>services/conversation/sovkora-conversation-service</module>
        <module>services/job/sovkora-job-service</module>
        <module>services/knowledge/sovkora-knowledge-service</module>
        <module>services/automation/sovkora-automation-service</module>
        <module>services/edge/sovkora-edge-service</module>
        <module>e2e/sovkora-e2e</module>
    </modules>
</project>
