apps/*/build/
apps/*/android/app/build/
workers/*/build/
**/dist/
**/*.tsbuildinfo
**/next-env.d.ts

# Logs
**/*debug.log*
**/*error.log*
yarn-error.log*

# Test
**/coverage/
**/test-results/

