{
  "name": "orazaka-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Sovkora Desktop — a Tauri 2 control panel and file bridge for the Sovkora sovereign AI platform (macOS).",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "sidecar": "node scripts/build-sidecar.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:journey && pnpm test:rust",
    "tauri": "tauri",
    "build:app": "pnpm sidecar && tauri build --bundles dmg --target aarch64-apple-darwin",
    "test:journey": "node --test scripts/test/*.test.mjs"
  },
  "dependencies": {
    "@krizaka/i18n": "0.2.7",
    "@krizaka/icons": "^0.9.1",
    "@krizaka/orazaka-design-system": "3.4.0",
    "@krizaka/query": "0.3.0",
    "@krizaka/tailwind": "3.79.0",
    "@krizaka/tokens": "3.79.0",
    "@krizaka/ui": "3.79.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@krizaka/org": "^0.7.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "orazakaCli": "1.1.0",
  "packageManager": "pnpm@12.10.1"
}
