{
  "name": "orazaka-mobile-client",
  "version": "1.0.0",
  "packageManager": "pnpm@12.10.1",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint src && npm run format:check",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:sonar && npm run test:links && npm run check:icons && npm run test:icons && npm run test:flows && npm run test:code-names && npm run check:code-names && npm run test:tools",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "test:sonar": "node --test scripts/sonar-coverage.test.mjs",
    "test:links": "node --test scripts/app-links.test.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "test:icons": "node --test scripts/check-icons.test.mjs",
    "test:flows": "node --test scripts/maestro-flows.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "check:code-names": "node scripts/check-code-names.mjs",
    "test:code-names": "node --test scripts/check-code-names.test.mjs",
    "test:tools": "node --test scripts/tool-path.test.mjs scripts/frame-clips.test.mjs"
  },
  "dependencies": {
    "@krizaka/app-config": "^0.2.0",
    "@krizaka/charts": "^0.8.0",
    "@krizaka/discovery": "^0.1.0",
    "@krizaka/i18n": "^0.2.7",
    "@krizaka/icons": "^0.5.1",
    "@krizaka/intl": "^0.4.1",
    "@krizaka/orazaka-shared": "^1.5.0",
    "@krizaka/query": "^0.3.0",
    "@krizaka/tokens": "^3.30.0",
    "@krizaka/ui": "^3.30.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@shopify/flash-list": "2.3.3",
    "date-fns": "^4.3.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@krizaka/config": "^0.20.0",
    "@krizaka/org": "^0.7.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^10",
    "jest": "~30.5.2",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
