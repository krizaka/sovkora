{
  "$schema": "https://github.com/krizaka/krizaka-agents/blob/main/schemas/precheck.schema.json",
  "budgetSeconds": 2400,
  "checks": [
    {
      "name": "media worker suite guard (ci.yml runs every suite)",
      "paths": [
        ".github/workflows/ci.yml"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pyyaml",
        "--with",
        "pika",
        "--with",
        "Pillow",
        "--with",
        "psutil",
        "--with",
        "cryptography",
        "--with",
        "numpy",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_main.py",
        "-k",
        "TheRunnerCollectsEveryDefinedTest"
      ],
      "cwd": "workers/media"
    },
    {
      "name": "dev-migration probes",
      "paths": [
        "infra/migrations/**",
        "scripts/dev-migration-probes.json",
        "scripts/lib/migration-probes.mjs"
      ],
      "run": [
        "node",
        "--test",
        "scripts/test/dev-migrations.test.mjs"
      ]
    },
    {
      "name": "script tests (ci.yml scripts job)",
      "paths": [
        "scripts/**",
        "modules.json",
        ".github/workflows/ci.yml"
      ],
      "run": [
        "node",
        "--test",
        "--test-timeout=120000",
        "scripts/test/*.test.mjs"
      ],
      "timeoutSeconds": 600
    },
    {
      "name": "media worker suites, with coverage (workers/media/coverage.xml)",
      "paths": [
        "workers/media/**",
        "apps/cli/src/services/image-model-recipes.json"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pytest-cov",
        "--with",
        "pyyaml",
        "--with",
        "pika",
        "--with",
        "Pillow",
        "--with",
        "psutil",
        "--with",
        "cryptography",
        "--with",
        "numpy",
        "python",
        "-m",
        "pytest",
        "-q",
        "--cov=.",
        "--cov-report=xml:coverage.xml",
        "test_capability_contract.py",
        "test_gpu_runtime.py",
        "test_image_to_video.py",
        "test_cut.py",
        "test_deliver.py",
        "test_foley.py",
        "test_mixer.py",
        "test_titles.py",
        "test_voice_direction.py",
        "test_remote_video.py",
        "test_sound_models.py",
        "test_main.py",
        "test_measure.py",
        "test_model_cache.py",
        "test_upscale.py",
        "test_sound_handler.py",
        "test_stages.py",
        "test_job_control.py",
        "test_ltx_video.py",
        "test_sound.py",
        "test_consumer_resilience.py",
        "test_cinematic_kit.py",
        "test_gpu_out.py",
        "test_hosted_worker.py",
        "test_speech_server.py",
        "test_spend.py",
        "test_dockerfile_pins.py",
        "test_failure_answer.py",
        "test_asset_sink_causes.py"
      ],
      "cwd": "workers/media",
      "timeoutSeconds": 900
    },
    {
      "name": "pack worker document-validation/worker (ci.yml Pack worker)",
      "paths": [
        "packs/document-validation/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pypdf",
        "--with",
        "pika",
        "--with",
        "pyyaml",
        "--with",
        "pikepdf",
        "--with",
        "reportlab",
        "--with",
        "Pillow",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_rules.py",
        "test_golden.py",
        "test_authenticity.py",
        "test_authenticity_formats.py",
        "test_forensics.py",
        "test_screening.py",
        "test_identify.py",
        "test_check.py",
        "test_regex_safety.py",
        "test_derivation.py",
        "test_lecture.py",
        "test_failure_answer.py",
        "quality/test_measure_lease.py"
      ],
      "cwd": "packs/document-validation/worker"
    },
    {
      "name": "pack worker message-authenticity/worker (ci.yml Pack worker)",
      "paths": [
        "packs/message-authenticity/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pika",
        "--with",
        "pyyaml",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_authenticity.py"
      ],
      "cwd": "packs/message-authenticity/worker"
    },
    {
      "name": "pack worker media-safety/worker (ci.yml Pack worker)",
      "paths": [
        "packs/media-safety/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pika",
        "--with",
        "pyyaml",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_safety.py"
      ],
      "cwd": "packs/media-safety/worker"
    },
    {
      "name": "pack worker data-analytics/worker (ci.yml Pack worker)",
      "paths": [
        "packs/data-analytics/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pika",
        "--with",
        "pyyaml",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_facts.py",
        "test_dashboard.py",
        "test_worker.py"
      ],
      "cwd": "packs/data-analytics/worker"
    },
    {
      "name": "pack worker echo-toolkit/worker (ci.yml Pack worker)",
      "paths": [
        "packs/echo-toolkit/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pika",
        "--with",
        "pyyaml",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_echo_worker.py"
      ],
      "cwd": "packs/echo-toolkit/worker"
    },
    {
      "name": "pack worker tenant-screening-qc/worker (ci.yml Pack worker)",
      "paths": [
        "packs/tenant-screening-qc/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pika",
        "--with",
        "pyyaml",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_screening.py"
      ],
      "cwd": "packs/tenant-screening-qc/worker"
    },
    {
      "name": "pack worker identity-document-check/worker (ci.yml Pack worker)",
      "paths": [
        "packs/identity-document-check/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pika",
        "--with",
        "pyyaml",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_mrz.py",
        "test_rules.py",
        "test_worker.py"
      ],
      "cwd": "packs/identity-document-check/worker"
    },
    {
      "name": "pack worker worker-common (ci.yml Pack worker)",
      "paths": [
        "packs/worker-common/**"
      ],
      "run": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "pytest",
        "--with",
        "pika",
        "python",
        "-m",
        "pytest",
        "-q",
        "test_worker_broker.py",
        "test_worker_loop.py",
        "test_worker_failure.py"
      ],
      "cwd": "packs/worker-common"
    },
    {
      "name": "automation service: build and tests (ci.yml Java reactor, changed module + upstream)",
      "paths": [
        "services/automation/**"
      ],
      "run": [
        "./mvnw",
        "-B",
        "-ntp",
        "-q",
        "-pl",
        "services/automation/sovkora-automation-service",
        "-am",
        "verify"
      ],
      "heavy": true,
      "timeoutSeconds": 1500
    },
    {
      "name": "conversation service: build and tests (ci.yml Java reactor, changed module + upstream)",
      "paths": [
        "services/conversation/**"
      ],
      "run": [
        "./mvnw",
        "-B",
        "-ntp",
        "-q",
        "-pl",
        "services/conversation/sovkora-conversation-service",
        "-am",
        "verify"
      ],
      "heavy": true,
      "timeoutSeconds": 1500
    },
    {
      "name": "edge service: build and tests (ci.yml Java reactor, changed module + upstream)",
      "paths": [
        "services/edge/**"
      ],
      "run": [
        "./mvnw",
        "-B",
        "-ntp",
        "-q",
        "-pl",
        "services/edge/sovkora-edge-service",
        "-am",
        "verify"
      ],
      "heavy": true,
      "timeoutSeconds": 1500
    },
    {
      "name": "job service: build and tests (ci.yml Java reactor, changed module + upstream)",
      "paths": [
        "services/job/**"
      ],
      "run": [
        "./mvnw",
        "-B",
        "-ntp",
        "-q",
        "-pl",
        "services/job/sovkora-job-service",
        "-am",
        "verify"
      ],
      "heavy": true,
      "timeoutSeconds": 1500
    },
    {
      "name": "knowledge service: build and tests (ci.yml Java reactor, changed module + upstream)",
      "paths": [
        "services/knowledge/**"
      ],
      "run": [
        "./mvnw",
        "-B",
        "-ntp",
        "-q",
        "-pl",
        "services/knowledge/sovkora-knowledge-service",
        "-am",
        "verify"
      ],
      "heavy": true,
      "timeoutSeconds": 1500
    },
    {
      "name": "studio services: build and tests",
      "paths": [
        "services/studio/**"
      ],
      "run": [
        "./mvnw",
        "-B",
        "-ntp",
        "-q",
        "-pl",
        "services/studio/sovkora-studio-api,services/studio/sovkora-studio-client,services/studio/sovkora-studio-service",
        "-am",
        "verify"
      ],
      "heavy": true,
      "timeoutSeconds": 1500
    },
    {
      "name": "governance tests of the whole tree (ci.yml every governance test)",
      "paths": [
        "build/**",
        "contracts/**",
        "engine/**",
        "pom.xml",
        "modules.json"
      ],
      "run": [
        "./mvnw",
        "-B",
        "-ntp",
        "-q",
        "-T",
        "4",
        "test",
        "-Dtest=*GovernanceTest",
        "-Dsurefire.failIfNoSpecifiedTests=false"
      ],
      "heavy": true,
      "timeoutSeconds": 1500
    }
  ]
}
