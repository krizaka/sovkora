<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.krizaka.sovkora</groupId>
        <artifactId>sovkora-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../sovkora-libs/sovkora-build/sovkora-parent/pom.xml</relativePath>
    </parent>

    <artifactId>sovkora-automation-service</artifactId>
    <name>sovkora-automation-service</name>
    <description>Automation service — connector execution, CLI-agent dispatch and scheduling (own database)</description>

    <url>https://github.com/krizaka/sovkora-automation-service</url>

    <scm>
        <url>https://github.com/krizaka/sovkora-automation-service</url>
        <connection>scm:git:https://github.com/krizaka/sovkora-automation-service.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/sovkora-automation-service.git</developerConnection>
    </scm>
    <licenses>
        <license>
            <name>FSL-1.1-ALv2</name>
            <url>https://fsl.software/FSL-1.1-ALv2.template.md</url>
            <distribution>repo</distribution>
            <comments>Functional Source License 1.1, Apache-2.0 future licence (ADR-011). Earlier commits: Apache-2.0.</comments>
        </license>
    </licenses>


    <properties>
        <!-- GitHub Packages repository this artifact is published to (sovkora-parent). -->
        <sovkora.repository>sovkora-automation-service</sovkora.repository>
    </properties>


    <dependencies>
        <!-- Krizaka platform kit: idempotent message consumption (claim / release). -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-billing-client</artifactId>
        </dependency>

        <!-- Krizaka platform kit: the session-JWT security baseline (ADR-035, ADR-073). -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-security</artifactId>
        </dependency>

        <!-- Tier-2 SDK: the master keyring of the asset store (ADR-054). A webhook trigger's secret is sealed
             under it (ADR-084 §1) — the mechanism of the platform, not a second one. -->
        <dependency>
            <groupId>com.krizaka.sovkora</groupId>
            <artifactId>sovkora-assets</artifactId>
        </dependency>

        <!-- Spring Boot Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Security: the API is session-JWT authenticated and scoped by the caller's id. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Outbound HTTP (AGENTS.md §4: RestClient): the Studio run an automation starts, as its owner. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Distributed tracing (Phase 0 observability baseline): Micrometer Tracing over the
             OpenTelemetry bridge, exported OTLP/HTTP to the local Jaeger container (:4318). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- Spring Boot AMQP (RabbitMQ) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Spring Boot Quartz Scheduler -->

        <!-- Spring Boot Data JPA (isolated persistence) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Flyway: the schema (db/migration) is applied at startup, before any store is used (krizaka-internal#2255) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON Processing -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.krizaka.sovkora</groupId>
            <artifactId>sovkora-test-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                      Coverage enforcement temporarily disabled for initial hardening pass.
                      The automation-worker test suite is not yet mature enough for the 80% gate.
                      Re-enable with <goal>check</goal> + 0.80 minimum once test authoring is complete.
                    -->
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
