<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.krizaka.sovkora</groupId>
        <artifactId>sovkora-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../build/sovkora-parent/pom.xml</relativePath>
    </parent>

    <artifactId>sovkora-edge-service</artifactId>
    <name>sovkora-edge-service</name>
    <description>Sovkora Edge Gateway — strangler facade: route table + streaming reverse proxy (transport only, no business logic)</description>

    <properties>
        <!-- 2.4.0 is the first line that supports Spring Boot 4 / Spring Framework 7 (krizaka-internal#2132).
             Only the framework-free core: no starter, no AOP; the edge binds its two meters itself. -->
        <resilience4j.version>2.4.0</resilience4j.version>
    </properties>





    <dependencies>
        <!-- Krizaka platform kit: session-JWT security baseline and service-to-service tokens. -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-security</artifactId>
        </dependency>
        <!-- Spring MVC + virtual threads (AGENTS.md §4 — no WebFlux, no Spring Cloud Gateway).
             A parked virtual thread per open SSE stream is the §4-compliant streaming model. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- RestClient over the JDK HttpClient factory — the §4-sanctioned outbound HTTP path
             (no hand-rolled java.net.http.HttpClient usage outside the Spring-managed factory). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- The shared limiter store (ADR-083 slice 3): Redis through Lettuce, only when ABUSE_RATE_LIMIT_STORE=redis. -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <!-- One circuit breaker per backend (krizaka-internal#2132): the edge fails fast with a coded 503
             instead of hanging on a backend that is down or slow. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <!-- Distributed tracing (Phase 0 observability baseline). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.krizaka.sovkora</groupId>
            <artifactId>sovkora-test-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
