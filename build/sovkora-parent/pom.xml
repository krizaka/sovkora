<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Sovkora inherits the Krizaka build from Maven Central: Java 21, formatting, tests, coverage,
         the enforced toolchain and the OpenRewrite style (krizaka/krizaka-java). What stays here is
         Sovkora's own: Spring AI, the Sovkora BOM, the naming guards of ADR-029, the .env-driven
         profiles and SonarCloud. -->
    <parent>
        <groupId>com.krizaka</groupId>
        <artifactId>krizaka-parent</artifactId>
        <version>0.12.0</version>
        <relativePath/>
    </parent>

    <groupId>com.krizaka.sovkora</groupId>
    <artifactId>sovkora-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>sovkora-parent</name>
    <description>Sovkora parent POM: Spring Boot / Spring AI BOMs, the Krizaka BOM, the Sovkora BOM (every component at one platform version) and the Sovkora profiles, on top of the Krizaka build conventions.</description>
    <url>https://github.com/krizaka/sovkora</url>

    <scm>
        <url>https://github.com/krizaka/sovkora</url>
        <connection>scm:git:https://github.com/krizaka/sovkora.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/sovkora.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/krizaka/sovkora/issues</url>
    </issueManagement>

    <properties>
        <!-- Security overrides of the Spring Boot BOM (Dependabot alerts): the patched releases of the libraries whose
             Boot-managed version is vulnerable. Drop each one when krizaka-parent / Spring Boot manages a fixed version. -->
        <krizaka.security.jackson3.version>3.2.4</krizaka.security.jackson3.version>
        <krizaka.security.jackson2.version>2.22.4</krizaka.security.jackson2.version>
        <krizaka.security.amqp-client.version>5.37.0</krizaka.security.amqp-client.version>
        <krizaka.security.opentelemetry.version>1.67.0</krizaka.security.opentelemetry.version>
        <krizaka.security.tomcat.version>11.0.27</krizaka.security.tomcat.version>
        <!-- The Krizaka artifacts (build, platform kit, users, notifications, billing) Sovkora
             is built on — one version, imported through krizaka-bom below. -->
        <krizaka.version>0.12.0</krizaka.version>

        <!-- ADR-029 N1/N2: the product of every module's coordinates (the enforcer rules below). -->
        <krizaka.product>sovkora</krizaka.product>

        <!-- Versions -->
        <!-- Spring AI 2.0 migration (ADR-030): Spring AI 2.0.0 GA requires Spring Boot 4 +
             Spring Framework 7 + Jackson 3. DELIBERATE override of the former AGENTS.md §11
             pin to the 3.5.0 line — update §11 accordingly. Verify the exact Boot 4 patch
             against the BOM if resolution fails. No -SNAPSHOT (GA only). -->
        <!-- spring-boot.version comes from krizaka-parent, so Sovkora and the Krizaka artifacts
             it consumes are always built against the same Boot line. -->
        <spring-ai.version>2.0.2</spring-ai.version>
        <graphql-spring-boot.version>15.0.0</graphql-spring-boot.version>
        <archunit.version>1.5.1</archunit.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <node.version>v24.11.1</node.version>

        <!-- SonarQube Cloud -->
        <sonar.organization>krizaka</sonar.organization>
        <sonar.projectKey>${sonar.organization}_sovkora</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.java.source>21</sonar.java.source>
        <sonar.coverage.jacoco.xmlReportPaths>**/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- 🔑 Token injected from env on CI or from .env locally -->
        <sonar.token>${env.SONAR_TOKEN}</sonar.token>

        <!-- 🌿 Branch detection: auto-resolved from git or overridden via -Dsonar.branch.name -->
        <sonar.branch.name></sonar.branch.name>

        <!-- 🚫 Exclusions: scratch files, test fixtures, generated code -->
        <sonar.exclusions>
            scratch/**/*,
            **/node_modules/**/*,
            **/dist/**/*,
            **/.next/**/*,
            **/target/**/*
        </sonar.exclusions>

        <!-- 📊 Coverage exclusions: boilerplate not requiring test coverage -->
        <sonar.coverage.exclusions>
            **/entity/**,
            **/converter/**,
            **/config/**,
            **/domain/model/**,
            **/*Application.java,
            **/Mapper.java,
            **/*Mapper.java,
            **/*Controller.java,
            **/core/infrastructure/**
        </sonar.coverage.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Security overrides: these come before the Boot BOM, so they win (first declaration wins). -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${krizaka.security.jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${krizaka.security.jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${krizaka.security.opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>${krizaka.security.amqp-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${krizaka.security.tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${krizaka.security.tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${krizaka.security.tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.krizaka</groupId>
                <artifactId>krizaka-bom</artifactId>
                <version>${krizaka.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal Modules -->
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-engine-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-studio-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-engine-assets</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-studio-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-jobs-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-engine-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-persistence-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-engine-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-engine-interceptors</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-engine-business</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-engine-persistence-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Shared Test Support -->
            <dependency>
                <groupId>com.krizaka.sovkora</groupId>
                <artifactId>sovkora-test-support</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Architectural Testing -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Repackage plugin version follows the Boot BOM — app poms must not pin it. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <!-- Every service says which build it is. Without this /actuator/info is
                             `{}`, and a stale JVM left over from a failed e2e run answers on the
                             right port with the wrong code — a green from yesterday's build that
                             nothing in the harness could distinguish from today's. The e2e
                             identity check compares what a service reports against the
                             build-info.properties on disk and refuses to test a process that is
                             not this build. -->
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>5.8.0.7211</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- ADR-029, the Java naming convention, held by the build (N1, N2, N3):
                 one groupId per product, artifactIds `sovkora-<module>[-<part>]` without the banned suffixes,
                 and no class in two jars. A rule that fails names the module and the rule. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.12.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>sovkora-coordinates</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>project.groupId</property>
                                    <regex>com\.krizaka\.${krizaka.product}</regex>
                                    <regexMessage>N1: the groupId of a Sovkora module is com.krizaka.${krizaka.product} (ADR-029).</regexMessage>
                                </requireProperty>
                                <requireProperty>
                                    <property>project.artifactId</property>
                                    <regex>^(?!.*-(?:common|utils?|impl|misc)(?:-|$))${krizaka.product}(?:-[a-z0-9]+)+$</regex>
                                    <regexMessage>N2: an artifactId is ${krizaka.product}-&lt;module&gt;[-&lt;part&gt;], lowercase kebab, never -common, -util(s), -impl or -misc (ADR-029).</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- N3, no split package: warn first (ADR-029, a new guard starts in warn); third-party duplicates are
                             reported too, so it turns to fail once they are listed. -->
                        <id>sovkora-no-duplicate-classes</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <fail>false</fail>
                            <rules>
                                <banDuplicateClasses>
                                    <findAllDuplicates>true</findAllDuplicates>
                                    <ignoreWhenIdentical>true</ignoreWhenIdentical>
                                    <scopes>
                                        <scope>compile</scope>
                                        <scope>runtime</scope>
                                    </scopes>
                                </banDuplicateClasses>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.3.1</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${maven.multiModuleProjectDirectory}/${env.file}</file>
                            </files>
                            <quiet>true</quiet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- ====================================================================
         ADR-040 V2: Industrial Maven Profile Matrix — dev / staging / prod
         dev     → ./mvnw compile            (default, skips E2E)
         staging → ./mvnw verify -P staging   (full E2E orchestration)
         prod    → ./mvnw package -P prod     (production dotenv, skips E2E)
         ==================================================================== -->
    <profiles>
        <profile>
            <id>dev</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <env.file>.env</env.file>
                <skip.e2e>true</skip.e2e>
            </properties>
        </profile>
        <profile>
            <id>staging</id>
            <properties>
                <env.file>.env</env.file>
                <skip.e2e>false</skip.e2e>
                <!-- E2E toolchain versions — only materialized in staging -->
                <docker-maven-plugin.version>0.45.1</docker-maven-plugin.version>
                <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
                <node.version>v24.11.1</node.version>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <env.file>.env.prod</env.file>
                <skip.e2e>true</skip.e2e>
            </properties>
        </profile>
    </profiles>

</project>